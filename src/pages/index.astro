---
import Base from '../layouts/Base.astro';
import { apps, categories, type CategoryEntry } from '../data/apps.ts';

// Sections follow the order of `categories`; any category an app uses that is
// not listed there goes last, in first-appearance order.
const sections: CategoryEntry[] = [...categories];
for (const app of apps) {
  if (!sections.some((c) => c.name === app.category)) sections.push({ name: app.category, key: '' });
}
const grouped = sections
  .map((category) => ({ category, apps: apps.filter((app) => app.category === category.name) }))
  .filter(({ apps: categoryApps }) => categoryApps.length > 0);

// Shared identity service: the header widget (session.js) and the account
// section below link to it. Local runs point it at the accounts stack.
const ACCOUNTS_URL = import.meta.env.PUBLIC_ACCOUNTS_URL || 'https://accounts.3m4.net';
// Payments portal: the hero and footer load its pay.js donate button, and the
// footer its public supporters list (tags below).
const PAYMENTS_URL = import.meta.env.PUBLIC_PAYMENTS_URL || 'https://payments.3m4.net';

const title = '3m4 — Apps index';
const description = 'Index of apps and tools published under 3m4.net, grouped by category.';
---
<Base title={title} description={description}>
  <main class="page">
    <header class="hero">
      <div class="top-controls">
        <!-- accounts.3m4.net session widget: Log in / Sign up, or avatar + menu
             (Profile, Log out) once signed in. One account for every 3m4 app. -->
        <div id="session" class="session-mount"></div>
        <button id="theme-toggle" type="button" aria-label="Theme">🌙</button>
        <div id="lang-sel"></div>
      </div>
      <p class="eyebrow">3m4.net</p>
      <h1 data-i18n="heading">Apps index</h1>
      <p class="lede" data-i18n="lede">
        Small tools and games I've built and published under this domain. New ones get added
        here as they ship.
      </p>
      <!-- pay.js (payments.3m4.net) appends its donate button here; see the
           tags below. :empty hides the mount so nothing shifts while the
           portal gates donations off for this viewer. -->
      <div id="support-hero" class="support-mount"></div>
    </header>

    <section class="category account" id="account">
      <h2 data-i18n="accountTitle">Your 3m4 account</h2>
      <div class="account-card">
        <p data-i18n="accountLede">
          One login for every app listed here. Sign up once, then use the same account in the
          shortener, metrics, retro, exp, smart-docs and bubbles.
        </p>
        <div class="account-actions" data-signed-out>
          <a class="btn btn-primary" href={`${ACCOUNTS_URL}/login`} data-account-link="login" data-i18n="accountLogin">Log in</a>
          <a class="btn" href={`${ACCOUNTS_URL}/signup`} data-account-link="signup" data-i18n="accountSignup">Sign up</a>
        </div>
        <div class="account-actions" data-signed-in hidden>
          <a class="btn" href={`${ACCOUNTS_URL}/profile`} data-i18n="accountManage">Manage account</a>
          <button class="btn" type="button" id="account-logout" data-i18n="accountLogout">Log out</button>
        </div>
      </div>
    </section>

    {
      grouped.map(({ category, apps: categoryApps }) => (
        <section class="category">
          <h2>
            <span {...(category.key ? { 'data-i18n': category.key } : {})}>{category.name}</span>
            {category.badge && (
              <span class="badge badge-beta" data-i18n={category.badge}>
                Beta
              </span>
            )}
          </h2>
          <div class="grid">
            {categoryApps.map((app) => {
              const isLive = app.status === 'live';
              const Tag = isLive ? 'a' : 'div';
              return (
                <Tag
                  class="card"
                  {...(isLive ? { href: app.url, target: '_blank', rel: 'noopener noreferrer' } : { 'aria-disabled': 'true' })}
                >
                  <div class="card-image">
                    {app.image ? (
                      <img src={app.image} alt="" loading="lazy" width="1200" height="630" />
                    ) : (
                      <div class="card-image-placeholder" aria-hidden="true">🚧</div>
                    )}
                  </div>
                  <div class="card-body">
                    <div class="card-top">
                      <h3>{app.name}</h3>
                      <span
                        class={`badge ${isLive ? 'badge-live' : 'badge-building'}`}
                        data-i18n={isLive ? 'live' : 'building'}
                      >
                        {isLive ? 'Live' : 'Building'}
                      </span>
                    </div>
                    <p data-i18n={`${app.id}Desc`}>{app.description}</p>
                    {isLive && <span class="card-url">{app.url.replace('https://', '')} →</span>}
                  </div>
                </Tag>
              );
            })}
          </div>
        </section>
      ))
    }

    <footer>
      <!-- pay.js supporters list (opted-in donors + GitHub sponsors). The
           widget renders nothing while the list is empty; :empty hides the
           mount so the footer does not grow an empty gap. -->
      <div id="supporters" class="supporters-mount"></div>
      <div id="support-footer" class="support-mount"></div>
      <p>
        <span data-i18n="madeBy">Made by</span>{' '}
        <a href="https://www.linkedin.com/in/enrique-magallon/" target="_blank" rel="noopener noreferrer">Enrique Magallón</a>
      </p>
    </footer>
  </main>
</Base>

<script is:inline src={`${ACCOUNTS_URL}/session.js`} data-mount="#session" defer></script>
<!-- pay.js donate buttons ("Buy me a beer"): one tag per mount (hero and
     footer); every tag shares one window.m4pay. The static sites report under
     the `info` app. The portal gates donations per viewer (rollout flag) and
     simply never mounts the button when they are off; the mounts are hidden
     while empty. `data-label` is the English default: src/i18n/index.ts
     rewrites it from the `donate` catalog key (data-i18n-label) on every
     language apply(), and pay.js re-renders its label when <html lang> changes. -->
{
  ['#support-hero', '#support-footer'].map((mount) => (
    <script
      is:inline
      src={`${PAYMENTS_URL}/pay.js`}
      data-app="info"
      data-kind="donate"
      data-currency="usd"
      data-amount="500"
      data-label="Buy me a beer 🍺"
      data-i18n-label="donate"
      data-mount={mount}
      defer
    />
  ))
}
<!-- pay.js supporters list: the `info` app's opted-in donors plus every public
     GitHub sponsor, as a row of chips under a title in the footer. Not gated;
     it mounts only once the portal returns at least one supporter. The title
     follows the language switch the same way the donate label does
     (`supporters` catalog key via data-i18n-label). -->
<script
  is:inline
  src={`${PAYMENTS_URL}/pay.js`}
  data-app="info"
  data-kind="supporters"
  data-limit="24"
  data-label="Thanks to our supporters"
  data-i18n-label="supporters"
  data-mount="#supporters"
  defer
></script>

<script>
  import { initI18n } from '../i18n';
  import { initThemeToggle } from '../theme';
  import { initAccountSection } from '../account';
  initI18n();
  initThemeToggle();
  initAccountSection();
</script>

<style>
  .page {
    max-width: 880px;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
  }

  .hero {
    position: relative;
    margin-bottom: 3rem;
  }

  .top-controls {
    position: absolute;
    top: 0;
    inset-inline-end: 0;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  #theme-toggle {
    display: flex;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 999px;
    padding: 6px 11px;
    font-size: 0.85rem;
    line-height: 1.4;
    cursor: pointer;
  }

  #theme-toggle:hover {
    background: var(--surface-hover);
    border-color: var(--accent);
  }

  .session-mount:empty {
    display: none;
  }

  .account-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.25rem;
  }

  .account-card p {
    margin: 0;
    flex: 1 1 32ch;
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .account-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* display: flex would beat the UA's [hidden] rule; keep the toggle working. */
  .account-actions[hidden] {
    display: none;
  }

  /* pay.js mounts (hero + footer). Hidden while empty so the layout does not
     shift when the portal keeps the button away (gated rollout, offline). */
  .support-mount {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .support-mount:empty {
    display: none;
  }

  .hero .support-mount {
    margin-top: 1.25rem;
  }

  footer .support-mount {
    justify-content: center;
    margin-bottom: 1rem;
  }

  /* pay.js supporters list (footer). The widget never mounts while the list
     is empty; :empty hides the mount so nothing shifts. */
  .supporters-mount {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .supporters-mount:empty {
    display: none;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .btn:hover {
    background: var(--surface-hover);
    border-color: var(--accent);
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0;
    max-width: 60ch;
    color: var(--text-dim);
    font-size: 1.05rem;
  }

  .category {
    margin-bottom: 2.5rem;
  }

  .category h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1rem;
    color: var(--text-dim);
    font-weight: 600;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition:
      transform 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  a.card:hover,
  a.card:focus-visible {
    background: var(--surface-hover);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  div.card[aria-disabled='true'] {
    opacity: 0.7;
    cursor: default;
  }

  .card-image {
    aspect-ratio: 1200 / 630;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    background: linear-gradient(135deg, var(--surface) 0%, var(--surface-hover) 100%);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .card p {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
  }

  .badge {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .badge-live {
    background: var(--accent);
    color: var(--accent-text);
  }

  .badge-building {
    background: var(--badge-building-bg);
    color: var(--badge-building-text);
  }

  .badge-beta {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding-top: calc(0.2rem - 1px);
    padding-bottom: calc(0.2rem - 1px);
  }

  .card-url {
    margin-top: auto;
    font-size: 0.85rem;
    color: var(--accent);
  }

  footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.85rem;
  }

  footer a {
    color: var(--text-dim);
    text-decoration: underline;
  }
</style>
